{% liquid
  assign section_id = 'ts-features-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="ts-features"
  style="
    --ts-bg: {{ section.settings.background_color }};
    --ts-top: {{ section.settings.padding_top }}px;
    --ts-bottom: {{ section.settings.padding_bottom }}px;
    --ts-max: {{ section.settings.content_width }}px;
    --ts-heading-size: {{ section.settings.heading_size }}px;
    --ts-heading-color: {{ section.settings.heading_color }};
    --ts-badge-bg: {{ section.settings.badge_color }};
    --ts-badge-icon: {{ section.settings.badge_icon_color }};
    --ts-title-size: {{ section.settings.feature_title_size }}px;
    --ts-title-color: {{ section.settings.feature_title_color }};
    --ts-sub-size: {{ section.settings.feature_sub_size }}px;
    --ts-sub-color: {{ section.settings.feature_sub_color }};
    --ts-img-radius: {{ section.settings.image_radius }}px;
  "
>
  <div class="ts-features__inner">
    <!-- Left Column: Content & Checkmark List -->
    <div class="ts-features__content">
      {% if section.settings.heading != blank %}
        <h2 class="ts-features__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="ts-features__list">
          {% for block in section.blocks %}
            <div class="ts-feature-item" {{ block.shopify_attributes }}>
              <div class="ts-feature-item__badge">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div class="ts-feature-item__text">
                {% if block.settings.title != blank %}
                  <h3 class="ts-feature-item__title">
                    {{ block.settings.title | escape }}
                  </h3>
                {% endif %}
                {% if block.settings.subtitle != blank %}
                  <p class="ts-feature-item__subtitle">
                    {{ block.settings.subtitle | escape }}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Right Column: Image -->
    <div class="ts-features__image-wrapper">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            class: 'ts-features__image',
            alt: section.settings.image.alt | default: section.settings.heading
        }}
      {% else %}
        <div class="ts-features__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    background: var(--ts-bg);
    padding: var(--ts-top) 24px var(--ts-bottom);
    font-family: inherit;
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} .ts-features__inner {
    max-width: var(--ts-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  /* Left Side Column */
  #{{ section_id }} .ts-features__content {
    flex: 1;
    max-width: 520px;
  }

  #{{ section_id }} .ts-features__heading {
    color: var(--ts-heading-color);
    font-size: var(--ts-heading-size);
    font-weight: 800;
    line-height: 1.25;
    margin: 0 0 32px;
  }

  /* Feature Item List */
  #{{ section_id }} .ts-features__list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #{{ section_id }} .ts-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  /* Circular Green Checkmark Badge */
  #{{ section_id }} .ts-feature-item__badge {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    border-radius: 50%;
    background-color: var(--ts-badge-bg);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  #{{ section_id }} .ts-feature-item__badge svg {
    width: 24px;
    height: 24px;
  }

  /* Text Group */
  #{{ section_id }} .ts-feature-item__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #{{ section_id }} .ts-feature-item__title {
    color: var(--ts-title-color);
    font-size: 18px;
    font-weight: 600;
    line-height: 28px;
    margin: 0;
  }

  #{{ section_id }} .ts-feature-item__subtitle {
    color: #6b7280;
    font-size: var(--ts-sub-size);
    line-height: 1.5;
    margin: 0;
  }

  /* Right Side Image */
  #{{ section_id }} .ts-features__image-wrapper {
    flex: 1;
    max-width: 520px;
    width: 100%;
  }

  #{{ section_id }} .ts-features__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: var(--ts-img-radius);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  #{{ section_id }} .ts-features__placeholder {
    width: 100%;
    background: #f3f4f6;
    border-radius: var(--ts-img-radius);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }

  #{{ section_id }} .ts-features__placeholder svg {
    width: 100%;
    height: 100%;
    max-height: 400px;
  }

  /* Mobile Responsive Breakpoints */
  @media screen and (max-width: 890px) {
    #{{ section_id }} .ts-features__inner {
      flex-direction: column;
      gap: 36px;
    }

    #{{ section_id }} .ts-features__content,
    #{{ section_id }} .ts-features__image-wrapper {
      max-width: 100%;
    }

    #{{ section_id }} .ts-features__heading {
      font-size: calc(var(--ts-heading-size) * 0.85);
      text-align: left;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    #{{ section_id }} .ts-features__list {
      gap: 20px;
    }

    #{{ section_id }} .ts-feature-item__badge {
      width: 32px;
      height: 32px;
      flex: 0 0 32px;
    }

    #{{ section_id }} .ts-feature-item__badge svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "TryScent Features Block",
  "tag": "section",
  "class": "section-tryscent-features",
  "settings": [
    {
      "type": "header",
