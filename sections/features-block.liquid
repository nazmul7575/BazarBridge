    {
      "type": "header",
      "content": "Right Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature Image"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Corner Radius",
      "min": 0,
