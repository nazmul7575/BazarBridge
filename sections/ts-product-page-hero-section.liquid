<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap');

  .hero-banner-{{ section.id }} {
    width: 100%;
    min-height: 620px;
    background-image: 
      linear-gradient(90deg, #f8f8f7f7, #f8f8f7ed 30%, #f8f8f7b8 46%, #f8f8f700 68%),
      url('{{ section.settings.bg_image | image_url: width: 1920 | default: "https://tryscent.co/cdn/shop/files/MAGYX_Site_Header.webp?v=1789790951&width=1920" }}');
    background-size: cover;
    background-position: right top;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    padding: 60px 20px;
    box-sizing: border-box;
  }

  .hero-banner-{{ section.id }} .hero-container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: flex-start;
  }

  .hero-banner-{{ section.id }} .hero-content {
    max-width: 500px;
    display: flex;
    flex-direction: column;
    text-align: left;
    font-family: 'Figtree', sans-serif;
    padding-left: 50px;
  }

  .hero-banner-{{ section.id }} .hero-heading {
    font-family: 'Figtree', sans-serif;
    font-size: 42px;
    line-height: 1.15;
    font-weight: 400;
    color: #1a1a1a;
    margin: 0 0 16px 0;
    letter-spacing: -0.5px;
  }

  .hero-banner-{{ section.id }} .hero-subheading {
    font-size: 15px;
    font-weight: 700;
    color: #2b2b2b;
    margin: 0 0 16px 0;
    line-height: 1.4;
  }

  .hero-banner-{{ section.id }} .hero-text-block {
    font-size: 15px;
    line-height: 1.6;
    color: #4a4a4a;
    margin: 0 0 12px 0;
    font-weight: 400;
  }


  @media screen and (max-width: 1024px) {
    .hero-banner-{{ section.id }} {
      background-position: 85% top;
    }
  }

  @media screen and (max-width: 768px) {
    .hero-banner-{{ section.id }} {
      min-height: 420px;
      padding: 40px 20px;
      background-position: 75% center;
    }

    .hero-banner-{{ section.id }} .hero-heading {
      font-size: 32px;
    }

    .hero-banner-{{ section.id }} .hero-content {
      max-width: 100%;
    }
  }
</style>

<div class="hero-banner-{{ section.id }}">
  <div class="hero-container">
    <div class="hero-content">
      {% if section.settings.heading != blank %}
        <h1 class="hero-heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="hero-subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}

      {% if section.settings.paragraph_1 != blank %}
        <p class="hero-text-block">{{ section.settings.paragraph_1 | escape }}</p>
      {% endif %}

      {% if section.settings.paragraph_2 != blank %}
        <p class="hero-text-block">{{ section.settings.paragraph_2 | escape }}</p>
      {% endif %}

      {% if section.settings.button1_text != blank or section.settings.button2_text != blank %}
        <div class="hero-btn-wrapper">
          {% if section.settings.button1_text != blank %}
            <a href="{{ section.settings.button1_link | default: routes.all_products_collection_url }}" class="hero-btn">
              {{ section.settings.button1_text | escape }}
            </a>
          {% endif %}

          {% if section.settings.button2_text != blank %}
            <a href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}" class="hero-btn hero-btn-secondary">
              {{ section.settings.button2_text | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nya dofter"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Det senaste från TryScent."
    },
    {
      "type": "text",
      "id": "paragraph_1",
      "label": "Paragraph Line 1",
      "default": "Nya dofter inspirerade av parfymerna alla pratar om just nu."
    },
    {
      "type": "text",
      "id": "paragraph_2",
      "label": "Paragraph Line 2",
      "default": "Hitta din nästa favorit innan alla andra gör det."
    },
    {
      "type": "text",
      "id": "button1_text",
      "label": "First Button Text"
    },
    {
      "type": "url",
      "id": "button1_link",
      "label": "First Button Link"
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Second Button Text"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Second Button Link"
    }
  ],
  "presets": [
    {
      "name": "Product Hero Banner"
    }
  ]
}
{% endschema %}