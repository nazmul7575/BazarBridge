{% liquid
  assign section_id = 'ts-bestsellers-bar-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="ts-bestsellers-bar"
  style="
    --ts-bg: {{ section.settings.background_color }};
    --ts-top: {{ section.settings.padding_top }}px;
    --ts-bottom: {{ section.settings.padding_bottom }}px;
    --ts-max: {{ section.settings.content_width }}px;
    --ts-text-color: {{ section.settings.text_color }};
    --ts-link-color: {{ section.settings.link_color }};
    --ts-pipe-color: {{ section.settings.divider_color }};
  "
>
  <div class="ts-bestsellers-bar__inner">
    {% if section.settings.heading != blank %}
      <div class="ts-bestsellers-bar__title-wrapper">
        <h2 class="ts-bestsellers-bar__title">{{ section.settings.heading | escape }}</h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="ts-bestsellers-bar__links">
        {% for block in section.blocks %}
          <div class="ts-bestsellers-bar__item" {{ block.shopify_attributes }}>
            <span class="ts-bestsellers-bar__prefix">{{ block.settings.prefix | escape }}</span>
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="ts-bestsellers-bar__link"
            >
              {{ block.settings.title | escape }}
            </a>
            {% unless forloop.last %}
              <span class="ts-bestsellers-bar__divider">|</span>
            {% endunless %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #{{ section_id }} {
    background-color: var(--ts-bg);
    padding: var(--ts-top) 24px var(--ts-bottom);
    font-family: inherit;
    color: var(--ts-text-color);
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} .ts-bestsellers-bar__inner {
    max-width: var(--ts-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  /* Left Side Title */
  #{{ section_id }} .ts-bestsellers-bar__title-wrapper {
    flex: 0 0 auto;
  }

  #{{ section_id }} .ts-bestsellers-bar__title {
    color: var(--ts-text-color);
    font-size: 20px;
    font-weight: 800;
    margin: 0;
    white-space: nowrap;
  }

  /* Right Side Links Grid / Flex */
  #{{ section_id }} .ts-bestsellers-bar__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 16px;
    text-align: center;
    font-size: 14px;
    line-height: 1.6;
  }

  #{{ section_id }} .ts-bestsellers-bar__item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  #{{ section_id }} .ts-bestsellers-bar__prefix {
    color: #e5e7eb;
    letter-spacing: 0.35px;
    line-height: 1;
    font-size: 14px;
  }

  #{{ section_id }} .ts-bestsellers-bar__link {
    color: var(--ts-link-color);
    font-weight: 700;
    text-decoration: underline;
    transition: opacity 0.2s ease;
  }

  #{{ section_id }} .ts-bestsellers-bar__link:hover {
    opacity: 0.8;
  }

  #{{ section_id }} .ts-bestsellers-bar__divider {
    color: #ffffff;
    margin-left: 8px;
    font-weight: 300;
  }

  /* Responsive Mobile Layout */
  @media screen and (max-width: 900px) {
    #{{ section_id }} .ts-bestsellers-bar__inner {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }

    #{{ section_id }} .ts-bestsellers-bar__links {
      justify-content: center;
    }
  }

  @media screen and (max-width: 600px) {
    #{{ section_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    #{{ section_id }} .ts-bestsellers-bar__title {
      font-size: 18px;
    }

    #{{ section_id }} .ts-bestsellers-bar__links {
      font-size: 12px;
    }
  }
</style>

