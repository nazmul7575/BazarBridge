{% liquid
  assign section_id = 'ts-benefits-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="ts-benefits-section"
  style="
    --ts-bg: {{ section.settings.background_color }};
    --ts-top: {{ section.settings.padding_top }}px;
    --ts-bottom: {{ section.settings.padding_bottom }}px;
    --ts-max: {{ section.settings.content_width }}px;
    --ts-gap: {{ section.settings.grid_gap }}px;
    --ts-icon-size: {{ section.settings.icon_size }}px;
    --ts-title-color: {{ section.settings.title_color }};
    --ts-title-size: {{ section.settings.title_size }}px;
    --ts-text-color: {{ section.settings.text_color }};
    --ts-text-size: {{ section.settings.text_size }}px;
  "
>
  <div class="ts-benefits__inner">
    {% if section.blocks.size > 0 %}
      <div class="ts-benefits__grid">
        {% for block in section.blocks %}
          <div class="ts-benefit-item" {{ block.shopify_attributes }}>
            <div class="ts-benefit-item__icon" aria-hidden="true">
              {% if block.settings.benefit_image != blank %}
                <img
                  src="{{ block.settings.benefit_image | image_url: width: 120 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ section.settings.icon_size }}"
                  height="{{ section.settings.icon_size }}"
                  class="ts-benefit-item__custom-img"
                >
              {% elsif block.settings.benefit_image_url != blank %}
                <img
                  src="{{ block.settings.benefit_image_url }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ section.settings.icon_size }}"
                  height="{{ section.settings.icon_size }}"
                  class="ts-benefit-item__custom-img"
                >
              {% else %}
                {% case block.settings.benefit_icon %}
                  {% when 'eu' %}
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="4" y="6" width="24" height="20" rx="2" />
                      <circle cx="16" cy="11" r="0.8" fill="currentColor" />
                      <circle cx="19.5" cy="12" r="0.8" fill="currentColor" />
                      <circle cx="21" cy="15.5" r="0.8" fill="currentColor" />
                      <circle cx="19.5" cy="19" r="0.8" fill="currentColor" />
                      <circle cx="16" cy="20" r="0.8" fill="currentColor" />
                      <circle cx="12.5" cy="19" r="0.8" fill="currentColor" />
                      <circle cx="11" cy="15.5" r="0.8" fill="currentColor" />
                      <circle cx="12.5" cy="12" r="0.8" fill="currentColor" />
                    </svg>
                  {% when 'perfume' %}
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="12" y="4" width="8" height="4" rx="1" />
                      <path d="M10 12h12v14a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V12Z" />
                      <path d="M12 8h8v4h-8z" />
                      <circle cx="16" cy="20" r="2.5" />
                    </svg>
                  {% when 'guarantee' %}
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                      <circle cx="16" cy="16" r="11" />
                      <path d="M16 9v7l4 3" stroke-linecap="round" />
                      <path d="M11 23l2.5 2.5 5.5-5.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  {% when 'clock' %}
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                      <circle cx="16" cy="17" r="11" />
                      <path d="M16 10v7l5 3M11 3h10" stroke-linecap="round" />
                    </svg>
                {% endcase %}
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <h3 class="ts-benefit-item__title">{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="ts-benefit-item__text">{{ block.settings.text | escape | newline_to_br }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #{{ section_id }} {
    background-color: var(--ts-bg);
    padding-top: var(--ts-top);
    padding-bottom: var(--ts-bottom);
    padding-left: 20px;
    padding-right: 20px;
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} .ts-benefits__inner {
    max-width: var(--ts-max);
    margin: 0 auto;
  }

  #{{ section_id }} .ts-benefits__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--ts-gap);
    align-items: start;
  }

  #{{ section_id }} .ts-benefit-item {
    text-align: center;
    min-width: 0;
  }

  #{{ section_id }} .ts-benefit-item__icon {
    width: var(--ts-icon-size);
    height: var(--ts-icon-size);
    margin: 0 auto 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ts-title-color);
  }

  #{{ section_id }} .ts-benefit-item__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #{{ section_id }} .ts-benefit-item__custom-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #{{ section_id }} .ts-benefit-item__title {
    color: var(--ts-title-color);
    font-size: var(--ts-title-size);
    line-height: 1.35;
    font-weight: 700;
    margin: 0 0 8px;
  }

  #{{ section_id }} .ts-benefit-item__text {
    color: var(--ts-text-color);
    font-size: var(--ts-text-size);
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 834px) {
    #{{ section_id }} .ts-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 20px;
    }
  }

  @media screen and (max-width: 480px) {
    #{{ section_id }} .ts-benefits__grid {
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "Benefits Row Only",
  "tag": "section",
  "class": "section-tryscent-benefits-only",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Maximum Width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap Between Items",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Typography & Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading Text Color",
      "default": "#111827"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Heading Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Text Color",
      "default": "#4A5568"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description Font Size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon/Image Display Size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "benefit_image",
          "label": "Upload Icon Image"
        },
        {
          "type": "url",
          "id": "benefit_image_url",
          "label": "Or Paste Image Link/URL"
        },
        {
          "type": "select",
          "id": "benefit_icon",
          "label": "Fallback SVG Icon",
          "options": [
            {"value": "eu", "label": "EU Clean Formula"},
            {"value": "perfume", "label": "Perfume Bottle"},
            {"value": "guarantee", "label": "Guarantee Shield"},
            {"value": "clock", "label": "Clock"}
          ],
          "default": "eu"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Ren formula"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Utan hormonstörande ämnen och parabener."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Row Only",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "benefit_icon": "eu",
            "title": "Ren formula",
            "text": "Utan hormonstörande ämnen och parabener."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "benefit_icon": "perfume",
            "title": "Över 100 dofter att välja mellan",
            "text": "En doft som märks och stannar kvar."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "benefit_icon": "guarantee",
            "title": "60 dagars garanti",
            "text": "Testa parfymen hemma. Är den inte rätt för dig har du 60 dagar på dig att returnera den."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "benefit_icon": "clock",
            "title": "Långvarig doft",
            "text": "Skapad för att hålla sig märkbar i upp till 12 timmar."
          }
        }
      ]
    }
  ]
}
{% endschema %}