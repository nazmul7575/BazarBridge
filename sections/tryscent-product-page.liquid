{%- comment -%}
  TryScent Product Page (compact)
  1. Setup  2. Styles  3. Markup  4. Script  5. Schema
  Desktop: gallery + feature cards left, info right. Mobile: one column, image edge to edge.
{%- endcomment -%}

{%- comment -%} ===== 1. SETUP ===== {%- endcomment -%}
{%- liquid
  assign sid = 'ts-pdp-' | append: section.id

  # Selected variant: URL ?variant=, else "Pre-selected size", else first available
  assign cv = product.selected_or_first_available_variant
  if product.selected_variant == nil and section.settings.default_variant != blank
    assign wanted = section.settings.default_variant | downcase | remove: ' '
    for v in product.variants
      assign v_name = v.title | downcase | remove: ' '
      if v_name == wanted and v.available
        assign cv = v
        break
      endif
    endfor
  endif

  # Gallery: product images + shared "Gallery image" blocks
  assign extra_count = 0
  assign feature_count = 0
  assign attrs_count = 0
  for block in section.blocks
    if block.type == 'gallery_image' and block.settings.image != blank
      assign extra_count = extra_count | plus: 1
    elsif block.type == 'gallery_feature'
      assign feature_count = feature_count | plus: 1
    elsif block.type == 'scent_attributes'
      assign attrs_count = attrs_count | plus: 1
    endif
  endfor
  # When those blocks are missing, show the default feature cards + scent icons
  assign auto = section.settings.auto_defaults

  assign show_extra = false
  assign own_count = product.media.size
  if extra_count > 0
    case section.settings.default_mode
      when 'replace'
        assign show_extra = true
        assign own_count = 1
      when 'append'
        assign show_extra = true
      else
        if product.media.size <= section.settings.default_when
          assign show_extra = true
        endif
    endcase
  endif
  if own_count > product.media.size
    assign own_count = product.media.size
  endif
  assign total_slides = own_count
  if show_extra
    assign total_slides = total_slides | plus: extra_count
  endif

  assign start_index = 0
  for media in product.media limit: own_count
    if media.id == cv.featured_media.id
      assign start_index = forloop.index0
    endif
  endfor

  # Icon library: names and SVG paths in the same order
  assign icon_names = 'bottle,stars,shield,truck,heart,leaf,check,timer,drop,daynight,summer,winter,night,intensity,flame,clipboard,globe,star,info' | split: ','
-%}
